    "Sıra", INTEGER,
    {
        {"< 5", BLANK(), 5, 1},
        {"5–10", 5, 10, 2},
        {"10–20", 10, 20, 3},
        {"20–50", 20, 50, 4},
        {"50+", 50, BLANK(), 5}
    }
)
